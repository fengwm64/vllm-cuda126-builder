# ==============================================================================
# vLLM minimal OpenAI API server image
#
# Expects vLLM wheel in ./wheels/ directory (produced by Dockerfile.builder)
#
# Build:
#   docker build -f Dockerfile.runtime \
#     --build-arg VLLM_WHEEL=wheels/vllm-0.20.1-cp312-cp312-linux_x86_64.whl \
#     -t vllm-openai:v0.20.1 .
# ==============================================================================

FROM nvidia/cuda:12.6.0-base-ubuntu22.04

ARG VLLM_WHEEL
ARG TORCH_CUDA_ARCH_LIST="8.0 8.6"

LABEL org.opencontainers.image.title="vLLM OpenAI Server" \
      org.opencontainers.image.description="vLLM OpenAI-compatible API server (CUDA 12.6)" \
      com.nvidia.cuda.version="12.6" \
      com.nvidia.gpu.arch="${TORCH_CUDA_ARCH_LIST}"

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH="/usr/local/cuda/compat:${LD_LIBRARY_PATH}"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}

# Install Python, CUDA runtime components for JIT, and basic system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3-pip \
    git \
    cuda-nvcc-12-6 \
    cuda-cudart-12-6 \
    cuda-nvrtc-12-6 \
    libcublas-dev-12-6 \
    libcurand-dev-12-6 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && python3.12 -m ensurepip --upgrade \
    && python3.12 -m pip install --upgrade pip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch + FlashInfer runtime
RUN --mount=type=cache,target=/root/.cache/pip \
    python3.12 -m pip install \
    torch==2.11.0 \
    torchvision==0.26.0 \
    torchaudio==2.11.0 \
    --index-url https://download.pytorch.org/whl/cu126

RUN --mount=type=cache,target=/root/.cache/pip \
    python3.12 -m pip install \
    flashinfer-python==0.6.8.post1 \
    --extra-index-url https://flashinfer.ai/whl/cu126

# Install vLLM from pre-built wheel
COPY ${VLLM_WHEEL} /tmp/vllm.whl
RUN --mount=type=cache,target=/root/.cache/pip \
    python3.12 -m pip install /tmp/vllm.whl \
    && rm /tmp/vllm.whl

WORKDIR /workspace

EXPOSE 8000

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
